# ClaimAssist v2 — environment template. Copy to .env (never commit .env).

# --- ClaimAssist API ---------------------------------------------------------
# Shared key required in the X-API-Key header on POST /ask and /ask/stream.
API_KEY=local-dev-key

# --- LiteLLM proxy (optional) --------------------------------------------------
# If set (and enabled in litellm/config.yaml general_settings), every call to
# the proxy must send Authorization: Bearer <this key>.
# LITELLM_MASTER_KEY=sk-litellm-change-me

# --- Cloud provider keys (CLOUD PATH — optional) --------------------------------
# Uncomment the matching model entry in litellm/config.yaml, set the key(s)
# here, then: docker compose restart litellm

# OpenAI
# OPENAI_API_KEY=sk-...

# Azure OpenAI
# AZURE_API_KEY=...
# AZURE_API_BASE=https://<your-resource>.openai.azure.com/

# AWS Bedrock
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION_NAME=us-east-1

# GCP Vertex AI
# VERTEXAI_PROJECT=your-project-id
# VERTEXAI_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
