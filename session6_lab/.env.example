# ClaimAssist — Session 6 environment
# The app always speaks the OpenAI protocol. These three variables are the
# ONLY switch between the local model container and any cloud provider.

# --- Local path (default) ----------------------------------------------------
# Inside docker compose the API reaches the model server by its service name
# ("model"). From your host shell, the same server is http://localhost:8090/v1
# (use that value instead if you run the API outside compose with uvicorn).
LLM_BASE_URL=http://model:8090/v1
LLM_API_KEY=local
LLM_MODEL=qwen-local

# --- Cloud path (optional): any OpenAI-compatible provider --------------------
# Uncomment the three lines below (and comment out the local block) — nothing
# else in the stack changes. That is the point of the protocol.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o-mini
