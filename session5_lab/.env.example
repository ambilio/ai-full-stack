# Copy to .env and edit:  cp .env.example .env
# .env is in .dockerignore — secrets never enter git or the image.

API_KEY=change-me-to-a-random-string

# Candidate behaviour for v2 — the "model upgrade" under evaluation.
# Step 2 uses this good value; the Step 5 incident drill replaces it with a bad one.
PREFIX_V2=Answer briefly, factually and politely.

# ---- Langfuse tracing (Step 1). Leave the keys blank until Langfuse is up:
# ---- the model servers run fine without them (tracing becomes a no-op).
#
# LOCAL path — self-hosted Langfuse from docker-compose.langfuse.yml.
# host.docker.internal lets the model containers reach the Langfuse container
# published on the host at :3005 (extra_hosts in docker-compose.yml maps it on Linux).
LANGFUSE_HOST=http://host.docker.internal:3005
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
#
# CLOUD path — free tier at https://cloud.langfuse.com (zero extra containers):
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
