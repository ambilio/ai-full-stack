# ClaimAssist v4 — environment template. Copy to .env (never commit .env).

# --- ClaimAssist API ---------------------------------------------------------
# Shared key required in the X-API-Key header on POST /ask, /ask/stream, /agent.
API_KEY=local-dev-key

# --- Agent -------------------------------------------------------------------
# llm     = real function calling via openrouter-mini (default)
# router  = deterministic intent routing (offline with qwen-local)
AGENT_MODE=llm

# Which model the app requests from the LiteLLM proxy.
LLM_MODEL=openrouter-mini
# Offline: LLM_MODEL=qwen-local and AGENT_MODE=router

# --- LiteLLM proxy (optional) --------------------------------------------------
# If set (and enabled in litellm/config.yaml general_settings), every call to
# the proxy must send Authorization: Bearer <this key>.
# LITELLM_MASTER_KEY=sk-litellm-change-me

# --- Cloud provider keys -------------------------------------------------------
# Required for openrouter-mini (default). Then: docker compose restart litellm
OPENROUTER_API_KEY=sk-or-...

# OpenAI (alternative — uncomment gpt-4o-mini in litellm/config.yaml)
# OPENAI_API_KEY=sk-...

# Azure OpenAI
# AZURE_API_KEY=...
# AZURE_API_BASE=https://<your-resource>.openai.azure.com/

# AWS Bedrock
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION_NAME=us-east-1

# GCP Vertex AI
# VERTEXAI_PROJECT=your-project-id
# VERTEXAI_LOCATION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
