# ClaimAssist v5 — environment template. Copy to .env (never commit .env).

# --- ClaimAssist API ---------------------------------------------------------
# Shared key required in the X-API-Key header on POST /ask.
API_KEY=local-dev-key

# --- Prompt release (v5) --------------------------------------------------------
# The ACTIVE prompt version from prompts/registry.yaml. Changing this line and
# restarting the api container IS a prompt release — in a real pipeline it
# passes the Session 3 eval gate first.
PROMPT_VERSION=v1

# --- Langfuse tracing (v5) --------------------------------------------------------
# LOCAL PATH: docker compose -f docker-compose.langfuse.yml up -d
#   then create org/project/API keys at http://localhost:3005 and paste them:
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=http://host.docker.internal:3005     # from inside the api container
#
# CLOUD PATH (optional): free project at https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
#
# With the keys unset, the API runs identically — just untraced (no-op).

# --- Models (defaults: OpenRouter) ---------------------------------------------
# LLM_MODEL=openrouter-mini
# Offline: LLM_MODEL=qwen-local

# --- LiteLLM proxy (optional) --------------------------------------------------
# LITELLM_MASTER_KEY=sk-litellm-change-me

# --- Cloud provider keys -------------------------------------------------------
# Required for openrouter-mini (default). Then: docker compose restart litellm
OPENROUTER_API_KEY=sk-or-...
# OpenAI (alternative — uncomment gpt-4o-mini in litellm/config.yaml)
# OPENAI_API_KEY=sk-...
# AZURE_API_KEY=...
# AZURE_API_BASE=https://<your-resource>.openai.azure.com/
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION_NAME=us-east-1
# VERTEXAI_PROJECT=your-project-id
# VERTEXAI_LOCATION=us-central1
